{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:streetwide:schema:tile-index:0.1",
  "title": "StreetWide tile index (world format 0.1)",
  "description": "Lists the assets of one z17 tile. Assets are sorted by (layer, feature_id) with no duplicates; the copied fields must match each manifest. See rfcs/0001-world-format.md section 4.",
  "type": "object",
  "additionalProperties": false,
  "required": ["assets", "contract_version", "format", "origin_mm", "region", "tile"],
  "properties": {
    "format": { "const": "streetwide.tile" },
    "contract_version": { "$ref": "urn:streetwide:schema:common:0.1#/$defs/contractVersion" },
    "tile": { "$ref": "urn:streetwide:schema:common:0.1#/$defs/tileKey" },
    "region": { "$ref": "urn:streetwide:schema:common:0.1#/$defs/regionKey" },
    "origin_mm": { "$ref": "urn:streetwide:schema:common:0.1#/$defs/vec3mm" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bounds_mm", "collider", "content_id", "feature_id", "layer", "license", "manifest_id"],
        "properties": {
          "layer": { "$ref": "urn:streetwide:schema:common:0.1#/$defs/layer" },
          "feature_id": { "$ref": "urn:streetwide:schema:common:0.1#/$defs/featureId" },
          "manifest_id": { "$ref": "urn:streetwide:schema:common:0.1#/$defs/contentId" },
          "content_id": { "$ref": "urn:streetwide:schema:common:0.1#/$defs/contentId" },
          "license": { "$ref": "urn:streetwide:schema:common:0.1#/$defs/license" },
          "collider": { "$ref": "urn:streetwide:schema:common:0.1#/$defs/collider" },
          "bounds_mm": { "$ref": "urn:streetwide:schema:common:0.1#/$defs/boundsMm" }
        },
        "allOf": [
          {
            "description": "Visual only (RFC 0003): water never collides. Checked here as well as in the manifest, because the simulation reads colliders from tile indexes and never opens manifests.",
            "if": {
              "required": ["layer"],
              "properties": { "layer": { "const": "water" } }
            },
            "then": {
              "properties": { "collider": { "const": "none" } }
            }
          }
        ]
      }
    }
  }
}
